# Copy to .env (or .env.local) and fill in. Never commit the real file.

# Public origin of the deployed site, without a trailing slash.
# Used for metadata, JSON-LD, sitemap, llms.txt, OpenAPI and the generated OG image.
NEXT_PUBLIC_SITE_URL=https://example.com

# GitHub OAuth app for the /admin blog editor sign-in (Worker only).
# Locally, `wrangler dev` reads these from .env or .dev.vars.
# In production, set them as Worker secrets: `bunx wrangler secret put GITHUB_CLIENT_ID`.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Optional: Chromium executable for `node scripts/build-cv.mjs` if Edge/Chrome is not in a standard path.
# CV_BROWSER=/usr/bin/chromium
