{
  "name": "site-portfolio",
  "compatibility_date": "2026-09-26",
  "main": "./worker/index.ts",
  "build": {
    "command": "bun run build"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The worker runs first on everything: it answers /oauth/*, /mcp and /api
    // itself, negotiates Markdown for pages and forwards the rest to assets.
    "run_worker_first": ["/*"]
  }
}
